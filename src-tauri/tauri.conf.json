{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "app",
  "version": "0.1.0",
  "identifier": "com.app.test",
  "build": {
    "frontendDist": "../apps/main/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter main dev",
    "beforeBuildCommand": "pnpm --filter main build"
  },
  "app": {
    "windows": [
      {
        "title": "app",
        "width": 1250,
        "height": 750,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
