{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "App",
  "version": "0.1.0",
  "identifier": "com.example.app",
  "build": {
    "frontendDist": "../apps/main/.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm --filter main dev",
    "beforeBuildCommand": "pnpm --filter main build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "App",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
